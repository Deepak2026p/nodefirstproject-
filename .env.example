# Copy this file to ".env" and fill in real values.
# This file is safe to commit; the real .env must NEVER be committed.

# ===========================================
#  SERVER
# ===========================================
PORT=8000
APP_NAME=nodeprojectwithsc

# ===========================================
#  POSTGRESQL — choose ONE of the options below
# ===========================================

# --- Option A: Local PostgreSQL (development) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=nodeprojectwithsc
DB_SSL=false

# --- Option B: Managed / Cloud PostgreSQL (production) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ===========================================
#  POOL TUNING (optional)
# ===========================================
DB_MAX_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
